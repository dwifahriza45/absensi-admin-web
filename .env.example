# Target backend untuk proxy Vite; browser mengakses /api pada host frontend.
VITE_API_URL=http://127.0.0.1:8082

# Docker: isi username/repository + tag SHA untuk deployment Docker Hub.
DOCKER_IMAGE=absensi-admin-web
IMAGE_TAG=local
WEB_PORT=8088
API_UPSTREAM=http://absensi-api:8087
API_NETWORK=absen
